import shutil, subprocess
from pathlib import Path
from IPython.display import Audio

def make_narration(script=NARRATION_SCRIPT, out=NARRATION_AUDIO, engine=TTS_ENGINE, voice=TTS_VOICE):
    "Synthesize the narration once. Returns the path of the audio file, or None."
    script, out = Path(script), Path(out)
    for existing in (out, out.with_suffix(".wav")):
        if existing.exists():
            return existing
    text = script.read_text()
    use_say = engine == "say" or (engine == "auto" and shutil.which("say") and shutil.which("afconvert"))
    if use_say:                                   # macOS: no install needed
        aiff = out.with_suffix(".aiff")
        cmd = ["say", "-r", "175", "-f", str(script), "-o", str(aiff)] + (["-v", voice] if voice else [])
        subprocess.run(cmd, check=True)
        if out.suffix == ".m4a":
            subprocess.run(["afconvert", str(aiff), "-o", str(out), "-f", "m4af", "-d", "aac"], check=True)
            aiff.unlink()
        else:
            aiff.rename(out)
        return out
    try:                                          # cross-platform neural voice
        from kokoro import KPipeline
        import soundfile as sf
    except ImportError:
        print("No speech engine found. On macOS this uses the built-in `say` command; elsewhere run\n"
              "  pip install kokoro soundfile\n"
              f"or record yourself reading {script} and save it as {out}.")
        return None
    pipe = KPipeline(lang_code="a")
    chunks = [audio for _, _, audio in pipe(text, voice=voice or "af_heart", speed=1.0)]
    wav = out.with_suffix(".wav")
    sf.write(wav, np.concatenate(chunks), 24000)
    return wav

