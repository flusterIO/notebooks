    pick += [g.name for g in sorted(gals, key=lambda g: -len(g.R)) if g.name not in pick][: 4 - len(pick)]
    kfit = fits[0.05]["glob"]["kappa"]
    fig, axs = plt.subplots(1, 4, figsize=(15, 3.8))
    for ax, n in zip(axs, pick):
        g = by_name[n]; Rm = g.R * K.KPC
        vb2 = (np.abs(g.Vgas) * g.Vgas + ups_d * np.abs(g.Vdisk) * g.Vdisk + ups_b * np.abs(g.Vbul) * g.Vbul) * 1e6
        gbar = np.maximum(vb2, 1e-6) / Rm
        ax.errorbar(g.R, g.Vobs, g.eV, fmt="o", color="k", ms=3, capsize=1.5, label="observed")
        ax.plot(g.R, np.sqrt(np.maximum(vb2, 0)) / 1e3, "--", color="gray", label="baryons (Newton)")
        ax.plot(g.R, np.sqrt(Rm * aw.rar(gbar, kfit * cH0)) / 1e3, color=PALETTE[1], lw=2.2, label=fr"Hypothesis M, $\kappa'={kfit:.3f}$")
        ax.set_title(n); ax.set_xlabel("R [kpc]")
    axs[0].set_ylabel("rotation speed [km/s]"); axs[0].legend(fontsize=8, loc="lower right")
    fig.suptitle("Examples at the common scale, catalogue distance and inclination, nominal mass-to-light ratios", y=1.02)
    plt.tight_layout(); plt.show()








